{{#> base-layout title="Solicitud de Datos Shopify"}}
  <tr>
    <td>
      <div class="content">
        <p>Hola {{nombre}},</p>
        <p>Hemos recibido una solicitud para proporcionarte tus datos de Shopify.</p>
        <p>A continuación te compartimos los datos solicitados:</p>
        <p>{{data}}</p>

        <ul style="text-align: left; margin: 0 auto; display: inline-block; text-align: left;">
          <li><strong>Nombre del cliente:</strong> {{data.user.name || '--'}}</li>
          <li><strong>Email:</strong> {{data.user.email || '--'}}</li>
          <li><strong>Teléfono:</strong> {{data.user.phone || '--'}}</li>
          <li><strong>Compañía:</strong> {{data.user.company || '--'}}</li>

          <li><strong>Nombre del canal:</strong> {{data.name || '--'}}</li>
          <li><strong>Fecha de inicio de descargas:</strong> {{data.initialDate || '--'}}</li>
          <li><strong>Typo de Ecommerce:</strong> {{data.ecommerceType || '--'}}</li>
          <li><strong>Sincronización de inventario:</strong> {{#if data.accountSettings}}{{data.accountSettings.syncInventory ? 'activa' : 'inactiva'}}{{else}}{{#if data.syncInventory}}{{data.syncInventory ? 'activa' : 'inactiva'}}{{else}}--{{/if}}{{/if}}</li>
        </ul>
      </div>
    </td>
  </tr>
{{/base-layout}}