{{#> base-layout title="Reporte de pedidos rezagados"}}
  <tr>
    <td>
      <div style="font-family: Arial, sans-serif; padding: 20px;">
        <h3 style="font-size: 18px; color: #1E1E1E;">Reporte de pedidos con atraso</h3>
        <p style="font-size: 16px;">Total de pedidos con atraso en el reporte: <strong>{{totalCount}}</strong></p>
        <p style="font-size: 14px; color: #666;">Se listan pedidos con estatus distinto a cancelado y entregado.</p>

        <div style="margin-top: 20px; background-color: #f9f9f9; padding: 15px; border-radius: 5px; overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
            <thead>
              <tr style="background-color: #FF6C0E; color: #fff;">
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Identificador del Marketplace</th>
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Folio Next</th>
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Canal</th>
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Usuario</th>
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Estatus</th>
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Última actualización</th>
                <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Días rezagados</th>
              </tr>
            </thead>
            <tbody>
              {{#each orders}}
              <tr style="background-color: #fff;">
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.ecommerceOrderId}}</td>
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.folioNext}}</td>
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.channelName}}</td>
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.userName}}</td>
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.status}}</td>
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.updatedAt}}</td>
                <td style="padding: 8px; border: 1px solid #ddd;">{{this.daysSinceUpdate}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <p style="font-size: 14px; margin-top: 20px;">Por favor, revise estos pedidos en el sistema para tomar las acciones necesarias.</p>
      </div>
    </td>
  </tr>
{{/base-layout}}
