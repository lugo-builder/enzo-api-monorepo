{{#> base-layout title="Solicitud de eliminación de datos de la tienda del cliente"}}
  <tr>
    <td>
      <div class="content">
        El cliente {{nombre}} ha solicitado la eliminación de los datos de su tienda.
        <p>
          Datos de la tienda:</p>
        <ul style="text-align: left; margin: 0 auto; display: inline-block; text-align: left;">
          <li><strong>Nombre:</strong> {{channelName}}</li>
          <li><strong>Short ID:</strong> {{channelShortId}}</li>
          <li><strong>Tipo:</strong> {{ecommerceType}}</li>
        </ul>
      </div>
    </td>
  </tr>
{{/base-layout}}