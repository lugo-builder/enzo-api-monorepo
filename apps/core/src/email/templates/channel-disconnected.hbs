{{#> base-layout title="Canal desconectado"}}
  <tr>
    <td>
      <div class="content">
        <h3>Canal desconectado</h3>
        <p>Estimado cliente,</p>
        <p>Un canal ha sido desconectado por problemas en la configuración.</p>
        <p>Detalles del canal:</p>
        <ul style="text-align: left; margin: 0 auto; display: inline-block; text-align: left;">
          <li><strong>Nombre del canal:</strong> {{channelName}}</li>
          <li><strong>Identificador del canal:</strong> {{channelShortId}}</li>
        </ul>
      </div>
    </td>
  </tr>
{{/base-layout}}