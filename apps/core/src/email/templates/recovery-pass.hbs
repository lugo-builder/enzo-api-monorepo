{{#> base-layout title="Restablecer Contraseña"}}
  <tr>
    <td>
      <div class="content">
        <h3>Restablecimiento de Contraseña</h3>
        <p>Hola {{nombre}},</p>
        <p>Hemos recibido una solicitud para restablecer tu contraseña.</p>
        <p>Para continuar, por favor haz clic en el siguiente enlace para restablecer tu contraseña:</p>
        <a href="{{enlace_restauracion}}" class="button">Restablecer Contraseña</a>
        <p>Si no solicitaste restablecer tu contraseña, puedes ignorar este correo.</p>
      </div>
    </td>
  </tr>
{{/base-layout}}