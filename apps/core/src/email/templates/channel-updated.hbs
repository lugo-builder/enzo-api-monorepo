{{#> base-layout title="Nuevo canal registrado"}}
  <tr>
    <td>
      <div class="content">
        <h3>Canal actualizado</h3>
        <p>Estimado cliente,</p>
        <p>Un canal ha sido actualizado por el administrador.</p>
        <p>Puede acceder a la plataforma de usuarios para visualizar la información.</p>
        <a href="{{url_fulfillment}}" class="button">Ir a la plataforma de usuarios</a>
        <p>Detalles del usuario:</p>
        <ul style="text-align: left; margin: 0 auto; display: inline-block; text-align: left;">
          <li><strong>Nombre:</strong> {{user_name}}</li>
          <li><strong>Email:</strong> {{user_email}}</li>
          <li><strong>Nombre del canal:</strong> {{channel_name}}</li>
          <li><strong>Identificador del canal:</strong> {{channel_shortId}}</li>
        </ul>
      </div>
    </td>
  </tr>
{{/base-layout}}