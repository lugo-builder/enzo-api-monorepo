<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Roboto', sans-serif;
      background-color: #f4f4f4;
    }

    table {
      width: 600px;
      margin: 20px auto;
      border: 0;
      border-spacing: 0;
      border-collapse: collapse;
    }

    .header {
      background-color: #FF6C0E;
      text-align: center;
      padding: 35px 0;
    }

    .header img {
      margin: auto;
      max-width: 5rem;
      padding-top: 1rem;
    }

    .content {
      background-color: #F1F1F1;
      padding: 40px 30px;
      text-align: center;
    }

    .content h3 {
      font-size: 1.5rem;
      font-weight: 400;
      color: #1E1E1E;
      margin: 0 0 16px 0;
    }

    .content h1 {
      font-size: 2.3rem;
      font-weight: 700;
      color: #FF6C0E;
      text-transform: uppercase;
      margin: 16px 0 24px 0;
    }

    .content p {
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.5;
      color: #1E1E1E;
      margin: 0 0 16px 0;
    }

    .button {
      display: inline-block;
      background-color: #FF6C0E;
      color: #FFFFFF !important;
      padding: 9px 24px;
      border-radius: 20px;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 500;
      margin: 20px 0;
    }

    .footer {
      background-color: #FF6C0E;
      text-align: center;
      font-size: 0.8rem;
      color: #F1F1F1;
      border-top: solid 10px #ff6c0e;
      border-bottom: solid 10px #ff6c0e;
    }

    .footer a {
      color: #F1F1F1;
      text-decoration: none;
      margin: 0 8px;
    }

    .footer .terms {
      border-left: 1px solid #F1F1F1;
      padding-left: 8px;
    }

    .copyright {
      font-size: 0.7rem;
      color: #F1F1F1;
    }

    .support {
      justify-content: center;
      align-items: center;
      margin-bottom: 5px;
    }

    .support img {
      vertical-align: middle;
      height: 1rem;
      padding: 0px 10px;
    }
  </style>
</head>

<body>
  <table>
    <thead class="header">
      <tr>
        <th>
          <img src="https://public/enzo.svg" alt="Enzo Logo">
        </th>
      </tr>
    </thead>
    <tbody>
      {{> @partial-block}}
    </tbody>
    <tfoot class="footer">
      <tr>
        <td>
          <div class="support">
            Atención al cliente: <img src="https://public/telWhite.png" alt="Teléfono">
          </div>
        </td>
      </tr>
      <tr>
        <td>
          <div class="support">
          </div>
        </td>
      </tr>
      <tr>
        <td>
          <div class="copyright">
            Enzo home service. All rights reserved.
          </div>
        </td>
      </tr>
    </tfoot>
  </table>
</body>

</html>