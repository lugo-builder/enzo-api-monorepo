{
  "name": "core",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/core/main",
    "start:dev:core": "nest start core --watch",
    "build:core": "nest build core",
    "start:debug:core": "nest start core --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/core/test/jest-e2e.json",
    "test:audit-logs": "ts-node -r tsconfig-paths/register --transpile-only scripts/test-audit-logs.ts",
    "seed:test-data": "ts-node -r tsconfig-paths/register --transpile-only scripts/seed-test-data-orders-products.ts",
    "copy:shared-templates": "cpx \"libs/common/src/email/templates/**/*\" dist/apps/core/shared-templates",
    "copy:core-templates": "cpx \"apps/core/src/email/templates/**/*\" dist/apps/core/templates",
    "copy:all-templates": "pnpm run copy:shared-templates && pnpm run copy:core-templates",
    "update-version": "node scripts/update-version.js",
    "prepare-production": "bash scripts/prepare-production-deploy.sh",
    "build:core:prod": "pnpm run update-version && pnpm run build:core",
    "build:core:sbx": "pnpm run update-version && pnpm run build:core"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.709.0",
    "@json2csv/node": "^7.0.6",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.4.1",
    "@ssut/nestjs-sqs": "^3.0.1",
    "amazon-sp-api": "^1.1.4",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "handlebars": "^4.7.8",
    "luxon": "^3.5.0",
    "nanoid": "^3.3.8",
    "passport-jwt": "^4.0.1",
    "pnpm": "^9.15.0",
    "qs": "^6.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "safe-stable-stringify": "^2.5.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cron": "^2.4.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.12",
    "@types/node": "20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cpx": "^1.5.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/log(|/.*)$": "<rootDir>/libs/log/src/$1",
      "^@app/erp-orders(|/.*)$": "<rootDir>/libs/erp-orders/src/$1"
    }
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "packageManager": "pnpm@10.3.0+sha512.ee592eda8815a8a293c206bb0917c4bb0ff274c50def7cbc17be05ec641fc2d1b02490ce660061356bd0d126a4d7eb2ec8830e6959fb8a447571c631d5a2442d"
}
