NODE_ENV="local"

# MySQL local (docker compose). Ver docker-compose.yml en la raíz.
DATABASE_URL="mysql://root:local_password@localhost:3306/enzo_db"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"
TOKEN_EXPIRATION_TIME="1h"

# Roles / password por defecto (usuarios creados desde admin)
DEFAULT_ROL="Default"
DEFAULT_ADMIN_ROL="Admin"
DEFAULT_PASSWORD="change-me"

# Frontends (enlaces en emails de registro / recuperación)
FRONTEND_URL="http://localhost:5172"
FRONTEND_ADMIN_URL="http://localhost:5173"
